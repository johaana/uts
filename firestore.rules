
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- HELPER FUNCTIONS ---
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isAdmin() {
      // Use Custom Claims (Auth Token) as the primary security boundary
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function getAgencyId() {
      // Trust the server-set claim, fallback to doc for safety
      return request.auth.token.agencyId != null 
        ? request.auth.token.agencyId 
        : getUserData().agencyId;
    }

    // --- COLLECTION RULES ---

    // User Profiles
    match /users/{userId} {
      // Users can read their own profile but NEVER write to it
      allow read: if isAuthenticated() && request.auth.uid == userId;
      // Admins have full access
      allow read, write: if isAdmin();
      // Block all client-side writes to identity fields
      allow create, update, delete: if false;
    }

    // Agencies
    match /agencies/{agencyId} {
      // Agency staff can read their own agency info
      allow read: if isAdmin() || (isAuthenticated() && getAgencyId() == agencyId);
      // Only admins can modify agency records (commission, status, etc.)
      allow write: if isAdmin();
    }

    // Policy Ledger (The Core Business Asset)
    match /policy_ledger/{transactionId} {
      // Multi-Tenant Isolation: Users only see their agency's sales
      allow read: if isAdmin() || (isAuthenticated() && resource.data.agencyId == getAgencyId());
      
      // PROTECT TRANSACTION INTEGRITY:
      // Clients can NEVER directly write to the ledger.
      // All writes must happen via Server Actions (Admin SDK).
      allow write: if false;
    }

    // Widgets Registry
    match /widgets/{widgetId} {
      // Public read for loading onto domains (logic handles whitelisting)
      allow read: if true;
      // Only admins manage distribution widgets
      allow write: if isAdmin();
    }
  }
}
