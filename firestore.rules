rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin()  { return signedIn() && request.auth.token.get('role', null) == 'admin'; }
    function myAgency() { return signedIn() ? request.auth.token.get('agencyId', null) : null; }

    // Identity: read own profile only. All writes via Admin SDK.
    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if false;
    }

    // Agencies: staff read own record; writes server-only.
    match /agencies/{agencyId} {
      allow read: if isAdmin() || (myAgency() != null && myAgency() == agencyId);
      allow write: if false;
    }

    // Ledger: tenant-isolated reads; no client writes.
    match /policy_ledger/{transactionId} {
      allow read: if isAdmin() || (myAgency() != null && resource.data.agencyId == myAgency());
      allow write: if false;
    }

    // Widgets: agency-scoped reads; public serving goes through a server route.
    match /widgets/{widgetId} {
      allow read: if isAdmin() || (myAgency() != null && resource.data.agencyId == myAgency());
      allow write: if false;
    }

    // Date Intelligence: published is public; drafts and all writes admin-only.
    match /intelligence_records/{recordId} {
      allow read: if resource.data.status == 'published' || isAdmin();
      allow write: if isAdmin();
    }
  }
}