{
  "entities": {
    "Agency": {
      "title": "Agency",
      "description": "Partner profile within the Utsavs distribution network.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "commissionRate": { "type": "number", "description": "Percentage share as a decimal (e.g. 0.10 for 10%)." },
        "status": { "type": "string", "enum": ["pending", "active", "suspended"] },
        "allowedDomains": { "type": "array", "items": { "type": "string" } },
        "onboardedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "contactEmail", "status", "commissionRate"]
    },
    "PolicyRecord": {
      "title": "Policy Record",
      "description": "Immutable transaction ledger entry representing a sale attempt.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "agencyId": { "type": "string" },
        "agencyUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "issued", "failed", "reconciliation_required", "voided", "void_failed"] },
        "policyNumber": { "type": "string" },
        "travelerName": { "type": "string" },
        "premiumAmount": { "type": "number" },
        "commissionRateAtSale": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "utsavsShareAmount": { "type": "number" },
        "documentUrl": { "type": "string" },
        "environment": { "type": "string", "enum": ["uat", "production"] },
        "providerId": { "type": "string", "default": "asego" },
        "issuedAt": { "type": "string", "format": "date-time" }
      }
    },
    "PortalUser": {
      "title": "Portal User",
      "description": "Authoritative mapping of authenticated users to roles and agencies.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "agency_staff"] },
        "agencyId": { "type": "string", "description": "ID of the associated agency." },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      }
    },
    "Widget": {
      "title": "Widget",
      "description": "Distribution registry for embeddable components.",
      "type": "object",
      "properties": {
        "widgetId": { "type": "string" },
        "agencyId": { "type": "string" },
        "type": { "type": "string", "enum": ["date_intelligence", "insurance_express"] },
        "status": { "type": "string", "enum": ["active", "suspended"] },
        "allowedDomains": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "auth": {
    "providers": ["password", "emailLink"]
  },
  "firestore": {
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/backend/entities/Agency" },
      "description": "Partner agency profiles."
    },
    "/policy_ledger/{policyId}": {
      "schema": { "$ref": "#/backend/entities/PolicyRecord" },
      "description": "Universal transaction ledger."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/PortalUser" },
      "description": "Authoritative identity and role-based access."
    },
    "/widgets/{widgetId}": {
      "schema": { "$ref": "#/backend/entities/Widget" },
      "description": "Widget distribution and domain control registry."
    }
  }
}