
{
  "entities": {
    "Agency": {
      "title": "Agency",
      "description": "Distribution partner record. Authoritative source for commission and domains.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "commissionRate": { "type": "number", "description": "Fixed decimal rate (e.g. 0.12). Captured at sale." },
        "status": { "type": "string", "enum": ["pending_review", "active", "suspended"] },
        "allowedDomains": { "type": "array", "items": { "type": "string" } }
      }
    },
    "PolicyRecord": {
      "title": "Policy Record",
      "description": "The Shadow Ledger entry. Immutable commercial snapshot.",
      "type": "object",
      "properties": {
        "transactionId": { "type": "string" },
        "agencyId": { "type": "string" },
        "agencyUserId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "issued", "failed", "reconciliation_required", "voided"] },
        "premiumAmount": { "type": "number" },
        "commissionRateAtSale": { "type": "number" },
        "utsavsShareAmount": { "type": "number" },
        "policyNumber": { "type": "string" },
        "documentUrl": { "type": "string" },
        "environment": { "type": "string", "enum": ["uat", "production"] }
      }
    },
    "PortalUser": {
      "title": "Portal User",
      "description": "Authoritative identity mapping. Backed by Custom Claims.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "agency_staff"] },
        "agencyId": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "suspended"] }
      }
    }
  },
  "auth": {
    "providers": ["emailLink"],
    "customClaims": ["role", "agencyId"]
  },
  "firestore": {
    "/users/{uid}": { "schema": { "$ref": "#/backend/entities/PortalUser" }, "description": "Identity vault." },
    "/agencies/{agencyId}": { "schema": { "$ref": "#/backend/entities/Agency" }, "description": "Partner registry." },
    "/policy_ledger/{txId}": { "schema": { "$ref": "#/backend/entities/PolicyRecord" }, "description": "Shadow financial ledger." }
  }
}
