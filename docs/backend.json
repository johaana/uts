{
  "entities": {
    "IntelligenceRecord": {
      "title": "Intelligence Record",
      "description": "A verified temporal record (holiday, policy, or operational signal).",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["draft", "published", "archived"] },
        "category": { "type": "string" },
        "jurisdiction": {
          "type": "object",
          "properties": {
            "country_code": { "type": "string" },
            "country_name": { "type": "string" },
            "region": { "type": "string" },
            "scope": { "type": "string", "enum": ["national", "regional", "local", "institutional"] }
          }
        },
        "consequences": {
          "type": "object",
          "properties": {
            "implication": { "type": "string" },
            "severity": { "type": "string", "enum": ["low", "medium", "high"] }
          }
        }
      }
    },
    "Agency": {
      "title": "Agency",
      "description": "Partner agency profile within the Utsavs ecosystem.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "contactEmail": { "type": "string", "format": "email" },
        "commissionTier": { "type": "number", "description": "Percentage share for the agency." },
        "status": { "type": "string", "enum": ["active", "suspended", "pending"] },
        "onboardedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "contactEmail"]
    },
    "PolicyRecord": {
      "title": "Policy Record",
      "description": "Shadow ledger entry for every policy issued via the engine.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "description": "Utsavs Internal ID" },
        "policyNumber": { "type": "string", "description": "Identifier from Underwriter/Asego" },
        "orderId": { "type": "string" },
        "agencyId": { "type": "string", "description": "ID of the agency that made the sale." },
        "travelerName": { "type": "string" },
        "premiumAmount": { "type": "number" },
        "currency": { "type": "string", "default": "INR" },
        "status": { "type": "string", "enum": ["issued", "voided", "expired"] },
        "issuedAt": { "type": "string", "format": "date-time" },
        "documentUrl": { "type": "string" }
      }
    },
    "PortalUser": {
      "title": "Portal User",
      "description": "Mapping of authenticated users to roles and agencies.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["admin", "agency_staff"] },
        "agencyId": { "type": "string", "description": "Null for platform admins." }
      }
    }
  },
  "auth": {
    "providers": ["password", "emailLink"]
  },
  "firestore": {
    "/intelligence_records/{recordId}": {
      "schema": { "$ref": "#/backend/entities/IntelligenceRecord" },
      "description": "Collection of all temporal and operational records."
    },
    "/agencies/{agencyId}": {
      "schema": { "$ref": "#/backend/entities/Agency" },
      "description": "Profiles for partner agencies."
    },
    "/policy_ledger/{policyId}": {
      "schema": { "$ref": "#/backend/entities/PolicyRecord" },
      "description": "The shadow ledger of all sales across the network."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/backend/entities/PortalUser" },
      "description": "Role-based access control mapping."
    }
  }
}